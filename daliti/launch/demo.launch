<launch>
	<arg name="dataset" default="hitsz" />
	<!-- VINS camera calibration: daliti/config/<camera_config>_camera.yaml (e.g. daliti-rooftop) -->
	<arg name="camera_config" default="$(arg dataset)" />
	<arg name="rosbag_file_with_path" default="" />
	<!-- playback window [s] relative to the bag start; the default duration plays the whole bag -->
	<arg name="bag_start" default="0" />
	<arg name="bag_duration" default="1000000" />
	<!-- Input topics for the image pipeline, selected by the demo profile. -->
	<arg name="input_config" default="$(find daliti)/config/indoor-smoke_input.yaml" />
	<arg name="trajectory_output_dir" default="$(find eskf_lio)/Log" />
	<arg name="trajectory_run_id" default="" />
	<arg name="ikdtree_async_rebuild" default="true" />
	<arg name="disable_ros1_eol_warnings" default="1" />
	<param name="dataset" type="string" value="$(arg dataset)" />
	<param name="mapping/trajectory_output_dir" type="string" value="$(arg trajectory_output_dir)" />
	<param name="mapping/trajectory_run_id" type="string" value="$(arg trajectory_run_id)" />
	<param name="mapping/ikdtree_async_rebuild" type="bool" value="$(arg ikdtree_async_rebuild)" />
	<param name="if_write_res_to_bag" type="int" value="0" />
	<param name="bag_file_name" type="string" value="~/daliti/src/DaLiTI/eskf_lio/Log/detail_result.bag" />


	<node pkg="rosbag" type="play" name="play" args="-r 1 -s $(arg bag_start) -u $(arg bag_duration) --pause '$(arg rosbag_file_with_path)'" />


	<!-- image front process tool -->
	<include file="$(find mytool)/launch/mytool.launch">
		<arg name="dataset" value="$(arg dataset)" />
	</include>
	<!-- Lidar odometry param -->
	<rosparam file="$(find daliti)/config/$(arg dataset)_lidar.yaml" command="load" />
	<rosparam file="$(arg input_config)" command="load" />
	<!-- VINS config -->
	<param name="vins_config_file" type="string" value="$(find daliti)/config/$(arg camera_config)_camera.yaml" />
	<!-- Image conversion -->
	<!-- <node pkg="image_transport" type="republish" name="republish" args="compressed in:=/camera/color/image_raw raw out:=/camera/color/image_raw" output="screen" respawn="true" /> -->
	<!-- - Robot State TF -->
	<include file="$(find daliti)/launch/include/module_robot_state_publisher.launch">
		<arg name="dataset" value="$(arg dataset)" />
	</include>
	<!-- - Run Rviz -->
	<include file="$(find daliti)/launch/include/module_rviz.launch">
		<arg name="disable_ros1_eol_warnings" value="$(arg disable_ros1_eol_warnings)" />
	</include>
	<include file="$(find daliti)/launch/include/module_sam.launch" />
	<include file="$(find eskf_lio)/launch/run.launch">
		<arg name="rviz" value="false" />
	</include>
</launch>
